<%= form_with model: task, id: "new_task_form", class: "flex flex-col gap-2" do |f| %>
  <% if task.errors.any? %>
    <p class="text-red-500 text-sm"><%= task.errors.full_messages.join(", ") %></p>
  <% end %>

  <div class="flex items-center gap-3">
    <%= f.text_field :title, class: "flex-1 border border-gray-300 rounded-lg px-3 py-2 focus:outline-none focus:ring-2 focus:ring-blue-400" %>
    <%= f.submit "บันทึก", class: "btn-primary" %>
    <% unless task.new_record? %>
      <%= link_to "กลับ", tasks_path, class: "btn-secondary" %>
    <% end %>
  </div>
<% end %>